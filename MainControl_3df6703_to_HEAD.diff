+        private bool IsBootloaderHandshakePacket(byte[] packet)
+        {
+            if (packet == null || packet.Length == 0)
+                return false;
+
+            // #U
+            if (packet.Length >= 2 &&
+                packet[0] == 0x23 &&
+                packet[1] == 0x55)
+                return true;
+
+            // YES
+            if (packet.Length >= 3 &&
+                packet[0] == 0x59 &&
+                packet[1] == 0x45 &&
+                packet[2] == 0x53)
+                return true;
+
+            return false;
+        }
